pickupArt = ExtResource("7_gbo44")
host = "luma"
shopTitle = "Luma's Star Stall"
shop = Array[ExtResource("9_1n1py")]([SubResource("Resource_x0n5v"), SubResource("Resource_m66ig"), SubResource("Resource_0c7l5"), SubResource("Resource_j4uye"), SubResource("Resource_wei4u")])
startText = "The stars are falling! Look for them on the islands after dark."
endText = "The sky is quiet again. The star fish sink back into the deep."
