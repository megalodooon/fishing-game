[resource]
script = ExtResource("4_colei")
displayName = "Farming Contest"
description = "Every Tuesday: harvest as much of the day's featured crop as you can. Medals pay Contest Ribbons, which Tilly trades for rare seeds and farm prizes."
icon = ExtResource("3_48aq7")
color = Color(0.5411765, 0.8156863, 0.2901961, 1)
weekday = 1
requiredFlag = "quest/q_meadow"
hours = Vector2(8, 18)
fishChance = 0.0
dropChances = PackedFloat32Array()
contest = &"harvest"
host = "tilly"
shopTitle = "Contest Prizes"
shop = Array[ExtResource("5_3srhj")]([SubResource("Resource_mmah4"), SubResource("Resource_n6cn4"), SubResource("Resource_tyg25"), SubResource("Resource_vg3su"), SubResource("Resource_p40bb"), SubResource("Resource_2x6cn")])
startText = "Tilly's Farming Contest is on! Check the featured crop."
