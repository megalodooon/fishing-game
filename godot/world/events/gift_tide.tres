[resource]
script = ExtResource("10_klq0o")
displayName = "Gift Tide"
description = "A whole week of winter wonders! Presents lie all over the islands and come up with your catch. Open them for surprises, or save them for Wally's Workshop on the village square."
icon = ExtResource("7_debka")
color = Color(0.9, 0.28, 0.32, 1)
season = 3
days = Vector2i(6, 8)
page = ExtResource("8_xmkkk")
drops = Array[ExtResource("3_0fp4h")]([ExtResource("4_gmxts"), ExtResource("5_ndf7a"), ExtResource("6_evrc3")])
dropChances = PackedFloat32Array(0.12, 0.02, 0.003)
creatures = Array[ExtResource("1_1bs5q")]([ExtResource("2_1lgs1")])
pickup = ExtResource("4_gmxts")
pickupsPerRoom = 3
pickupArt = ExtResource("9_ac7x3")
host = "wally"
shopTitle = "Wally's Workshop"
shop = Array[ExtResource("11_e5oe1")]([SubResource("Resource_akpf1"), SubResource("Resource_e0dgn"), SubResource("Resource_3oin1"), SubResource("Resource_t0dip"), SubResource("Resource_5n6ws"), SubResource("Resource_10nk7")])
startText = "Presents everywhere! Check every island, and don't forget Wally's Workshop in the square."
endText = "The Gift Tide is over. Wally waves goodbye until next winter."
