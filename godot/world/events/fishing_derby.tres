contest = &"derby"
host = "hale"
shopTitle = "Derby Prizes"
shop = Array[ExtResource("5_6bs6a")]([SubResource("Resource_cxjil"), SubResource("Resource_ah47n"), SubResource("Resource_oddmp"), SubResource("Resource_tww4e"), SubResource("Resource_mydxp"), SubResource("Resource_s10wq")])
startText = "The Fishing Derby is on! Hale has the featured fish."
