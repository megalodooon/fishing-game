[resource]
script = ExtResource("4_limdm")
displayName = "Fishing Derby"
description = "Every Wednesday morning: land the heaviest catch of the day's featured fish. Bronze, silver and gold medals pay Contest Ribbons, which Hale trades for prizes."
icon = ExtResource("3_83wq6")
color = Color(0.3529412, 0.6901961, 0.9098039, 1)
