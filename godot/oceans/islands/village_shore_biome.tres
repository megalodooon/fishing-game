[resource]
script = ExtResource("1_biome")
displayName = "Village Shore"
description = "The calm water around the village. Spots don't come up often, but they do."
fish = Array[ExtResource("1_data")]([ExtResource("f_2"), ExtResource("f_3"), ExtResource("f_4"), ExtResource("f_5"), ExtResource("f_6"), ExtResource("f_7")])
page = ExtResource("1_page")
