[ext_resource type="Resource" path="res://fishing/fish/species/sardine.tres" id="f_2"]
[ext_resource type="Resource" path="res://fishing/fish/species/anchovy.tres" id="f_3"]
[ext_resource type="Resource" path="res://fishing/fish/species/islands/harbor_goby.tres" id="f_4"]
